# Server-only, powers the free AEO/GEO audit + Scrunch brand-setup generation.
# Two providers are wired up side by side so we can flip between them without a code change --
# handy when one runs out of credits mid-event. See AGENTS.md for setup details on each.
#
# Fallback only — live switch is Stand desk → Settings (Firestore tmf_scrunch_settings/app).
# Unset or anything other than "gemini" = Azure until you save in the admin UI.
AI_PROVIDER=azure

# --- Azure OpenAI (org IT AI sandbox, SitecoreOpenAI-Sandbox-ET) --------------------------
# Create a chat-model deployment in Azure AI Foundry -> Deployments first (gpt-4o-mini is the
# cheap option; gpt-4o costs more per token -- see AGENTS.md for current deployment + pricing).
AZURE_OPENAI_API_KEY=
# Resource name only, e.g. "sitecoreopenai-sandbox-et" (from the resource's "Endpoint" field:
# https://<resource-name>.openai.azure.com/) — not the full URL.
AZURE_OPENAI_RESOURCE_NAME=
# The deployment NAME you chose in Azure AI Foundry, not the base model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Optional — only set if the SDK default API version errors against your resource.
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Gemini (Google AI Studio) -- the original engine, kept wired up for when Azure or ------
# --- Gemini credits run low; set AI_PROVIDER=gemini above to switch to it. ------------------
# Create a key at https://aistudio.google.com/apikey — never commit it, never paste it in admin UI.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional: override in-app cost estimate ($ per 1M tokens). Defaults assume gpt-4o-mini-ish
# rates; the gpt-4o deployment costs noticeably more per token, so set these if you want an
# accurate running total while gpt-4o is active.
# GEMINI_INPUT_USD_PER_MILLION=0.15
# GEMINI_OUTPUT_USD_PER_MILLION=0.6

# Firebase project id — used server-side to write booth leads to tmf_scrunch_leads.
# Safe to expose; the kiosk has no client Firestore SDK and no login.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Server-only: Firebase Admin service account JSON as a single line (Vercel + lead writes).
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Never commit the real JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
#
# Local alternative: point to the downloaded JSON file (do not commit the file)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Server-only: passcodes for the hidden /stand-desk page. Never commit the real values.
# LEADS_ADMIN_SECRET=          booth AEs — view, add, run audits
# LEADS_SUPER_ADMIN_SECRET=    stand admin — archive, hide, remove, Scrunch connect/sync

# Email sending is currently disabled in the app. Leave these blank.
# RESEND_API_KEY=
# EMAIL_FROM=

# Bot protection uses Vercel BotID (no Cloudflare / no extra keys).
# On Vercel, POST /api/audit/generate is checked with checkBotId().
# Locally it always allows humans. Optional salt for hashed IPs:
# AUDIT_LOG_SALT=

# Optional: Scrunch Configuration API (org admin -> API Keys). Server-only. Never commit the real key.
# Not called in v1 — the audit runs on Azure OpenAI research only (see docs in AGENTS.md). Wire this up
# later for a live mention-rate check. Never put real org/brand ids in docs or .env.example.
# SCRUNCH_API_TOKEN=

# Public label shown in the site footer/header — safe to expose in the browser.
NEXT_PUBLIC_SITE_URL=https://www.sitecore.com/

# Optional public presenter email (footer / Book a demo). Leave blank to omit from the site.
# NEXT_PUBLIC_PRESENTER_EMAIL=
