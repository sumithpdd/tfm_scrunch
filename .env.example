# Gemini — server-only, powers the free AEO/GEO audit (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Firebase project id — used server-side to write booth leads to tmf_scrunch_leads.
# Safe to expose; the kiosk has no client Firestore SDK and no login.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Server-only: Firebase Admin service account JSON as a single line (Vercel + lead writes).
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Never commit the real JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
#
# Local alternative: point to the downloaded JSON file (do not commit the file)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Server-only: passcodes for the hidden /stand-desk page. Never commit the real values.
# LEADS_ADMIN_SECRET=          booth AEs — view, add, run audits
# LEADS_SUPER_ADMIN_SECRET=    stand admin — archive, hide, remove, Scrunch connect/sync

# Server-only: send the audit PDF to the visitor (https://resend.com/api-keys).
# EMAIL_FROM must be a verified Resend sender, e.g. Sitecore Scrunch <reports@your-domain.com>
# RESEND_API_KEY=
# EMAIL_FROM=

# Optional: Scrunch Configuration API (org admin -> API Keys). Server-only. Never commit the real key.
# Not called in v1 — the audit runs on Gemini research only (see docs in AGENTS.md). Wire this up later
# for a live mention-rate check. Never put real org/brand ids in docs or .env.example.
# SCRUNCH_API_TOKEN=

# Public label shown in the site footer/header — safe to expose in the browser.
NEXT_PUBLIC_SITE_URL=https://www.sitecore.com/

# Optional public presenter email (footer / Book a demo). Leave blank to omit from the site.
# NEXT_PUBLIC_PRESENTER_EMAIL=
