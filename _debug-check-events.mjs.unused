import { readFileSync } from "node:fs";
import { initializeApp, cert } from "firebase-admin/app";
import { getFirestore } from "firebase-admin/firestore";

const envText = readFileSync(".env.local", "utf-8");
const line = envText.split("\n").find((l) => l.startsWith("FIREBASE_SERVICE_ACCOUNT_JSON="));
if (!line) throw new Error("FIREBASE_SERVICE_ACCOUNT_JSON not found in .env.local");
const json = line.slice("FIREBASE_SERVICE_ACCOUNT_JSON=".length).trim();
const creds = JSON.parse(json);

initializeApp({ credential: cert(creds) });
const db = getFirestore();

const snap = await db
  .collection("tmf_scrunch_audit_events")
  .orderBy("createdAt", "desc")
  .limit(10)
  .get();

if (snap.empty) {
  console.log("NO EVENTS FOUND in tmf_scrunch_audit_events");
} else {
  snap.forEach((doc) => {
    const d = doc.data();
    console.log("----", doc.id, "----");
    console.log("outcome:", d.outcome);
    console.log("website:", d.website);
    console.log("company:", d.company);
    console.log("error:", d.error);
    console.log("durationMs:", d.durationMs);
    console.log("createdAt:", d.createdAt?.toDate?.()?.toISOString?.() ?? d.createdAt);
  });
}
process.exit(0);
